# Optional frontend overrides. Copy to .env.local only if you need them.
#
# By default the frontend calls the API through Vite's /api proxy, which keeps
# the session cookie first-party during local development:
#   VITE_API_BASE_URL=
#
# Set an absolute URL only when the API is served from another origin and its
# CORS configuration allows this frontend:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
