# Sahayak local configuration. Copy to .env and edit if needed.
# The demo runs fully with LLM_PROVIDER=mock and no paid API keys.

# --- Core ---
LLM_PROVIDER=mock
SECRET_KEY=change-this-to-a-long-random-string-in-production
DATABASE_URL=sqlite:///./data/sahayak.db
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Optional real providers ---
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage and privacy ---
DOCUMENT_DIR=./data/documents
RECEIPT_DIR=./data/receipts
SCREENSHOT_DIR=./data/screenshots
DOCUMENT_TTL_HOURS=24

# --- Session cookie ---
SESSION_COOKIE_NAME=sahayak_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=2592000

# --- Agent / mock portal ---
BACKEND_BASE_URL=http://localhost:8000
MOCK_PORTAL_BASE_URL=http://localhost:8000/mock-portal
MOCK_PORTAL_USERNAME=demo
MOCK_PORTAL_PASSWORD=demo123
PLAYWRIGHT_HEADLESS=true
